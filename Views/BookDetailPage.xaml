<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ProyectoFinal_Movil_BibliotecaPersonal.ViewModels"
             x:Class="ProyectoFinal_Movil_BibliotecaPersonal.Views.BookDetailPage"
              Style="{StaticResource PageStyle}"
             Title="Detalle del Libro">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Detalle y Edición" Style="{StaticResource TitleStyle}"/>

            <Label Text="Título *" Style="{StaticResource CaptionStyle}"/>
            <Entry Text="{Binding BookTitle, Mode=TwoWay}"
                   Style="{StaticResource StandardEntryStyle}"/>

            <Label Text="Autor *" Style="{StaticResource CaptionStyle}"/>
            <Entry Text="{Binding Author, Mode=TwoWay}"
                   Style="{StaticResource StandardEntryStyle}"/>

            <Label Text="ISBN" Style="{StaticResource CaptionStyle}"/>
            <Entry Text="{Binding ISBN, Mode=TwoWay}"
                   Keyboard="Numeric"
                   Style="{StaticResource StandardEntryStyle}"/>

            <Label Text="Año" Style="{StaticResource CaptionStyle}"/>
            <Entry Text="{Binding Year, Mode=TwoWay}"
                   Keyboard="Numeric"
                   Style="{StaticResource StandardEntryStyle}"/>

            <Label Text="Género" Style="{StaticResource CaptionStyle}"/>
            <Picker ItemsSource="{Binding Genres}"
                    SelectedItem="{Binding Genre, Mode=TwoWay}"
                    Title="Selecciona género"
                    TextColor="{AppThemeBinding Light=#8B4513, Dark=#DEB887}"/>

            <Label Text="Páginas" Style="{StaticResource CaptionStyle}"/>
            <Entry Text="{Binding Pages, Mode=TwoWay}"
                   Keyboard="Numeric"
                   Style="{StaticResource StandardEntryStyle}"/>

            <Label Text="Calificación (1-5)" Style="{StaticResource CaptionStyle}"/>
            <Slider Minimum="1" Maximum="5" Value="{Binding Rating, Mode=TwoWay}"
                    MinimumTrackColor="{AppThemeBinding Light=#8B4513, Dark=#CD853F}"
                    MaximumTrackColor="#CCCCCC"/>
            <Label Text="{Binding Rating, StringFormat='⭐ {0:F0}'}"
                   HorizontalOptions="Center"/>

            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="¿Ya lo leíste?" Style="{StaticResource BodyStyle}" VerticalOptions="Center"/>
                <CheckBox Grid.Column="1" IsChecked="{Binding IsRead, Mode=TwoWay}"
                          Color="{AppThemeBinding Light=#8B4513, Dark=#CD853F}"/>
            </Grid>

            <Label Text="Notas" Style="{StaticResource CaptionStyle}"/>
            <Editor Text="{Binding Notes, Mode=TwoWay}"
                    Placeholder="Notas personales..."
                    HeightRequest="80"
                    BackgroundColor="{AppThemeBinding Light=#FFF8DC, Dark=#3D3020}"/>

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                               Color="{AppThemeBinding Light=#8B4513, Dark=#CD853F}"/>

            <Button Text="💾 Guardar Cambios"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="0,10,0,0"/>

            <Button Text="🗑 Eliminar Libro"
                    Command="{Binding DeleteCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"
                    CornerRadius="8"
                    Padding="16,10"/>

            <Button Text="Cancelar"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>