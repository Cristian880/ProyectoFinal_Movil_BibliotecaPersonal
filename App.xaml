<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ProyectoFinal_Movil_BibliotecaPersonal"
             xmlns:converters="clr-namespace:ProyectoFinal_Movil_BibliotecaPersonal.Converters"
             x:Class="ProyectoFinal_Movil_BibliotecaPersonal.App">
    <Application.Resources>
        <ResourceDictionary>

            <!--CONVERTERS-->
            <converters:BoolToReadConverter x:Key="BoolToReadConverter"/>
            <converters:BoolToColorConverter x:Key="BoolToColorConverter"/>
            <converters:RatingToStarsConverter x:Key="RatingToStarsConverter"/>

            <!--COLORERS LIGHT-->
            <Color x:Key="PrimaryLight">#8B4513</Color>
            <Color x:Key="SecondaryLight">#D2691E</Color>
            <Color x:Key="BackgroundLight">#FAF0E6</Color>
            <Color x:Key="SurfaceLight">#FFF8DC</Color>
            <Color x:Key="TextPrimaryLight">#1A1A1A</Color>
            <Color x:Key="TextSecondaryLight">#555555</Color>
            <Color x:Key="BorderLight">#DEB887</Color>

            <!--COLORES DARK-->
            <Color x:Key="PrimaryDark">#CD853F</Color>
            <Color x:Key="SecondaryDark">#DEB887</Color>
            <Color x:Key="BackgroundDark">#2C2416</Color>
            <Color x:Key="SurfaceDark">#3D3020</Color>
            <Color x:Key="TextPrimaryDark">#F5F5DC</Color>
            <Color x:Key="TextSecondaryDark">#C8B89A</Color>
            <Color x:Key="BorderDark">#6B4E2A</Color>

            <!-- TitleStyle -->
            <Style x:Key="TitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="28"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                Dark={StaticResource PrimaryDark}}"/>
            </Style>

            <!-- SubtitleStyle -->
            <Style x:Key="SubtitleStyle" TargetType="Label">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                Dark={StaticResource PrimaryDark}}"/>
            </Style>
            
            <!-- BodyStyle -->
            <Style x:Key="BodyStyle" TargetType="Label">
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                Dark={StaticResource TextPrimaryDark}}"/>
            </Style>

            <!-- CaptionStyle -->
            <Style x:Key="CaptionStyle" TargetType="Label">
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                Dark={StaticResource TextSecondaryDark}}"/>
            </Style>

            <!-- CardStyle -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                Dark={StaticResource SurfaceDark}}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Stroke"
                        Value="{AppThemeBinding Light={StaticResource BorderLight},
                                                Dark={StaticResource BorderDark}}"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="8,4"/>
                <Setter Property="StrokeShape">
                    <Setter.Value>
                        <RoundRectangle CornerRadius="10"/>
                    </Setter.Value>
                </Setter>
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#80000000" Offset="0,2" Radius="4" Opacity="0.15"/>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- SecondaryButtonStyle -->
            <Style x:Key="SecondaryButtonStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                Dark={StaticResource PrimaryDark}}"/>
                <Setter Property="BorderColor"
                        Value="{AppThemeBinding Light={StaticResource PrimaryLight},
                                                Dark={StaticResource PrimaryDark}}"/>
                <Setter Property="BorderWidth" Value="1.5"/>
                <Setter Property="CornerRadius" Value="8"/>
                <Setter Property="Padding" Value="16,10"/>
                <Setter Property="HeightRequest" Value="44"/>
            </Style>

            <!-- StandardEntryStyle -->
            <Style x:Key="StandardEntryStyle" TargetType="Entry">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceLight},
                                                Dark={StaticResource SurfaceDark}}"/>
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource TextPrimaryLight},
                                                Dark={StaticResource TextPrimaryDark}}"/>
                <Setter Property="PlaceholderColor"
                        Value="{AppThemeBinding Light={StaticResource TextSecondaryLight},
                                                Dark={StaticResource TextSecondaryDark}}"/>
                <Setter Property="HeightRequest" Value="44"/>
                <Setter Property="Margin" Value="0,4"/>
            </Style>

            <!-- PageBackgroundStyle -->
            <Style x:Key="PageStyle" TargetType="ContentPage">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource BackgroundLight},
                                                Dark={StaticResource BackgroundDark}}"/>
            </Style>
            
        </ResourceDictionary>
    </Application.Resources>
</Application>
